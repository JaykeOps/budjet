{
  "name": "budjet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prototype:visual-language": "vite --open '/?variant=A'",
    "prototype:budget-screen": "vite --open '/?budget=A'",
    "prototype:record": "vite --open '/?record=A'",
    "prototype:assign": "vite --open '/?assign=A'",
    "prototype:accounts": "vite --open '/?accounts=A'",
    "prototype:first-run": "vite --open '/?first=A'",
    "prototype:categories": "vite --open '/?cats=A'",
    "prototype:record-desktop": "vite --open '/?recd=A'",
    "prototype:pwa-icon": "vite --open '/?icon=K1'",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --project unit",
    "test:performance": "vitest run --project performance",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/gabarito": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
